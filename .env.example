# Voorbeeld van de omgevingsvariabelen. GEEN echte waarden in dit bestand of in Git zetten.
# In productie: Vercel → Project → Settings → Environment Variables.

# --- E-mail (bestaand) ---
RESEND_API_KEY=
AANVRAAG_TO=info@mideavastgoed.nl
# Afzender: een adres op het in Resend geverifieerde domein. Een mailbox is niet nodig.
AANVRAAG_FROM="MV Funderingsscan <noreply@mvfunderingsquickscan.nl>"
# Waar antwoorden van klanten heen gaan (standaard info@mideavastgoed.nl)
AANVRAAG_REPLY_TO=info@mideavastgoed.nl

# --- Database en opslag (Supabase, EU-regio) ---
# Project URL, bijv. https://abcdefgh.supabase.co
SUPABASE_URL=
# Geheime server-sleutel (service_role of sb_secret_…). NOOIT in de browser of in Git.
SUPABASE_SERVICE_KEY=

# --- Overig ---
# Basisadres voor links in e-mails (zonder slash aan het eind)
MVFS_SITE_URL=https://www.mvfunderingsquickscan.nl
# Willekeurige geheime tekst voor het hashen van IP-adressen bij rate limiting (bijv. 32+ tekens)
MVFS_PEPPER=

# --- Alleen lokaal ontwikkelen (npm run dev) ---
# MVFS_DB=memory
# MVFS_DB_FILE=tmp/dev-db.json

# Vertaalknop (optioneel). Zonder sleutel is de knop verborgen. Gratis sleutels eindigen op :fx.
DEEPL_API_KEY=
# DEEPL_MAAND_LIMIET=450000

# --- Medewerkers op de website ---
# Deploy Hook-URL uit Vercel (Settings → Git → Deploy Hooks). Na een wijziging in het portaal wordt de site opnieuw gebouwd.
VERCEL_DEPLOY_HOOK=
