{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "mvfunderingsscan.nl"
        }
      ],
      "destination": "https://www.mvfunderingsscan.nl/:path*",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/fase-0/",
      "destination": "/fase-0-funderingsonderzoek/",
      "permanent": true
    },
    {
      "source": "/fase-1/",
      "destination": "/fase-1-funderingsonderzoek/",
      "permanent": true
    },
    {
      "source": "/fase0/",
      "destination": "/fase-0-funderingsonderzoek/",
      "permanent": true
    },
    {
      "source": "/fase1/",
      "destination": "/fase-1-funderingsonderzoek/",
      "permanent": true
    },
    {
      "source": "/quickscan/",
      "destination": "/quickscan-fundering/",
      "permanent": true
    },
    {
      "source": "/aanvragen/",
      "destination": "/funderingsscan-aanvragen/",
      "permanent": true
    },
    {
      "source": "/kennisbank/wat-is-fase-0-funderingsonderzoek/",
      "destination": "/kennisbank/wat-is-fase-0/",
      "permanent": true
    },
    {
      "source": "/kennisbank/wat-is-fase-1-funderingsonderzoek/",
      "destination": "/kennisbank/wat-is-fase-1/",
      "permanent": true
    },
    {
      "source": "/kennisbank/wat-kost-een-funderingsonderzoek/",
      "destination": "/kennisbank/wat-kost-een-funderingsscan/",
      "permanent": true
    },
    {
      "source": "/kennisbank/funderingsonderzoek-bij-aankoop/",
      "destination": "/kennisbank/funderingsscan-bij-aankoop/",
      "permanent": true
    },
    {
      "source": "/kennisbank/scheuren-in-de-gevel-en-fundering/",
      "destination": "/kennisbank/scheuren-in-gevel/",
      "permanent": true
    },
    {
      "source": "/woningkopers/",
      "destination": "/funderingsonderzoek-bij-aankoop/",
      "permanent": true
    },
    {
      "source": "/verkopers/",
      "destination": "/funderingsonderzoek-bij-verkoop/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(styles.css|script.js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "mvfunderingsscan.vercel.app"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ]
}
