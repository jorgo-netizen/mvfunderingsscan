{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "mvfunderingsquickscan.nl"
        }
      ],
      "destination": "https://www.mvfunderingsquickscan.nl/:path*",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/fase-0/",
      "destination": "/fase-0-funderingsonderzoek/",
      "permanent": true
    },
    {
      "source": "/fase-1/",
      "destination": "/fase-1-funderingsonderzoek/",
      "permanent": true
    },
    {
      "source": "/fase0/",
      "destination": "/fase-0-funderingsonderzoek/",
      "permanent": true
    },
    {
      "source": "/fase1/",
      "destination": "/fase-1-funderingsonderzoek/",
      "permanent": true
    },
    {
      "source": "/quickscan/",
      "destination": "/quickscan-fundering/",
      "permanent": true
    },
    {
      "source": "/aanvragen/",
      "destination": "/funderingsscan-aanvragen/",
      "permanent": true
    },
    {
      "source": "/kennisbank/wat-is-fase-0-funderingsonderzoek/",
      "destination": "/kennisbank/wat-is-fase-0/",
      "permanent": true
    },
    {
      "source": "/kennisbank/wat-is-fase-1-funderingsonderzoek/",
      "destination": "/kennisbank/wat-is-fase-1/",
      "permanent": true
    },
    {
      "source": "/kennisbank/wat-kost-een-funderingsonderzoek/",
      "destination": "/kennisbank/wat-kost-een-funderingsscan/",
      "permanent": true
    },
    {
      "source": "/kennisbank/funderingsonderzoek-bij-aankoop/",
      "destination": "/kennisbank/funderingsscan-bij-aankoop/",
      "permanent": true
    },
    {
      "source": "/kennisbank/scheuren-in-de-gevel-en-fundering/",
      "destination": "/kennisbank/scheuren-in-gevel/",
      "permanent": true
    },
    {
      "source": "/woningkopers/",
      "destination": "/funderingsonderzoek-bij-aankoop/",
      "permanent": true
    },
    {
      "source": "/verkopers/",
      "destination": "/funderingsonderzoek-bij-verkoop/",
      "permanent": true
    },
    {
      "source": "/funderingsscan-check/",
      "destination": "/gratis-funderingscheck/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(styles.css|script.js|tools.css|tools.js|portaal.css|status.js|beheer.js|beheer-markdown.js|lintvoegmeting.js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "(?<sub>.+)\\.vercel\\.app"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/beheer/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'sha256-/x7W7R75k8Roq0WaVRQX9blP4OufE5xbAdzklGxsgpw='; style-src 'self'; img-src 'self' data: blob: https://*.supabase.co; connect-src 'self' https://*.supabase.co; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/status/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'sha256-/x7W7R75k8Roq0WaVRQX9blP4OufE5xbAdzklGxsgpw='; style-src 'self'; img-src 'self' data: blob: https://*.supabase.co; connect-src 'self' https://*.supabase.co; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/nieuws/",
      "destination": "/api/nieuws"
    },
    {
      "source": "/nieuws/:slug/",
      "destination": "/api/nieuws?slug=:slug"
    },
    {
      "source": "/nieuws-sitemap.xml",
      "destination": "/api/nieuws?sitemap=1"
    }
  ],
  "functions": {
    "api/nieuws.js": {
      "includeFiles": "src/**"
    },
    "api/beheer.js": {
      "includeFiles": "{src,rapport-sjabloon}/**",
      "maxDuration": 30
    }
  }
}
