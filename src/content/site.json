  "glossaryExtra": [
    {
      "name": "Lintvoeg",
      "description": "Een doorlopende horizontale metselvoeg in een gevel die bij de bouw vrijwel waterpas is gemetseld en daardoor bruikbaar is als referentie voor hoogtemetingen.",
      "href": "/kennisbank/lintvoegwaterpassing/"
    },
    {
      "name": "Vloerveld",
      "description": "Het vloeroppervlak van een vertrek of een deel van de vloer tussen dragende muren, waarop bij een vloerveldwaterpassing een raster van meetpunten wordt gemeten.",
      "href": "/kennisbank/vloerveldwaterpassing/"
    },
    {
      "name": "Maaiveld",
      "description": "De hoogte van het terrein rondom een woning. Een dalend maaiveld kan wijzen op bodemdaling of inklinking van de ondergrond.",
      "href": "/kennisbank/maaiveldhoogte/"
    },
    {
      "name": "NAP (Normaal Amsterdams Peil)",
      "description": "Het landelijke referentievlak voor hoogtes in Nederland. Hoogtemetingen kunnen ten opzichte van NAP of ten opzichte van een eigen referentiepunt worden bepaald.",
      "href": "/kennisbank/hoogtemeting/"
    },
    {
      "name": "KCAF-risicoklasse",
      "description": "Indeling van het funderingsrisico van een woning in klasse A (geen risico) tot en met E (vastgesteld funderingsprobleem) in het funderingsrisicorapport van het KCAF. Het is een inschatting op basis van gegevens, geen vaststelling van de staat van de fundering.",
      "href": "/funderingsonderzoek-taxatie/"
    },
    {
      "name": "Funderingsparagraaf",
      "description": "Het onderdeel over funderingsrisico in het model Taxatierapport Woonruimte. Sinds 1 april 2026 neemt de taxateur daarin de KCAF-risicoklasse A tot en met E op.",
      "href": "/kennisbank/funderingsscan-en-taxatie/"
    },
    {
      "name": "Inspectieput",
      "description": "Een plaatselijke uitgraving naast de woning om de fundering direct te bekijken, eventueel met houtonderzoek bij houten palen. In gemeentelijke regelingen valt dit vaak onder fase 2; bij MV Funderingsscan valt het buiten fase 0 en fase 1.",
      "href": "/kennisbank/wat-na-een-quickscan/"
    },
    {
      "name": "Peilbuis",
      "description": "Een buis in de grond waarmee de grondwaterstand op een vaste plek wordt gemeten, vaak als onderdeel van een meetnet van overheid of waterschap.",
      "href": "/kennisbank/grondwatermeting/"
    },
    {
      "name": "Monitoring",
      "description": "Het herhaald meten of vastleggen van scheuren, hoogtes of scheefstand over een langere periode, om te zien of beweging nog doorgaat.",
      "href": "/kennisbank/monitoring-scheuren/"
    },
    {
      "name": "Latei",
      "description": "Een balk of constructie boven een raam- of deuropening die het metselwerk erboven draagt. Een roestende stalen latei kan scheuren boven kozijnen veroorzaken.",
      "href": "/kennisbank/scheuren-boven-kozijnen/"
    }
  ],
