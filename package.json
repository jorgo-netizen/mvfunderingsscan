{
  "name": "mvfunderingsscan",
  "version": "1.0.0",
  "private": true,
  "description": "Website MV Funderingsscan (mvfunderingsscan.nl) – statische site, gegenereerd met Node, zonder dependencies.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "preview": "node scripts/build.mjs && node scripts/dev.mjs --no-watch",
    "audit": "node scripts/build.mjs && node scripts/audit.mjs",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  }
}
